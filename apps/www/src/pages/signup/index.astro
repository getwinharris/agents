---
import '../../styles/global.css';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Create your bapX account</title><link rel="icon" href="/favicon.svg"/></head><body class="auth-page"><main class="auth-card"><a href="https://bapx.in/" class="auth-brand"><img src="/brand/bapx-logo-main.svg" alt="bapX"/></a><p class="mono-label">CREATE ACCOUNT</p><h1>Create your account.</h1><p>Sign up with an email and password, or with your verified GitHub identity. A password is never stored in readable form.</p><p id="error" class="auth-error" role="alert"></p><form class="auth-form" id="password-form" method="post" action="/api/auth/password/register" data-action="/api/auth/password/register"><input class="auth-input" type="text" name="name" autocomplete="name" placeholder="Your name (optional)"/><input class="auth-input" type="email" name="email" autocomplete="email" placeholder="Email address" required/><input class="auth-input" type="password" name="password" autocomplete="new-password" placeholder="Password" required minlength="8" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[^A-Za-z0-9]).{8,}" title="Use at least 8 characters with uppercase, lowercase, a number, and a symbol."/><small class="auth-hint">At least 8 characters with uppercase, lowercase, a number, and a symbol.</small><button class="bapx-pill bapx-pill-primary auth-submit" type="submit">Create account</button></form><p class="auth-divider"><span>or</span></p><a class="bapx-pill bapx-pill-primary github-auth" href="/api/auth/oauth/github">Create account with GitHub</a><p class="auth-foot">Already registered? <a href="https://bapx.in/login/">Sign in</a></p></main><script is:inline>const rawError=new URLSearchParams(location.search).get('error')||'';document.querySelector('#error').textContent=/not configured/i.test(rawError)?'GitHub signup is temporarily unavailable. Please try again shortly.':rawError;</script><script is:inline>(()=>{const form=document.querySelector('#password-form');const errorBox=document.querySelector('#error');const returnTo=new URLSearchParams(location.search).get('returnTo')||'';form?.addEventListener('submit',async(event)=>{event.preventDefault();errorBox.textContent='';const submit=form.querySelector('.auth-submit');submit.disabled=true;const body=Object.fromEntries(new FormData(form));if(returnTo)body.returnTo=returnTo;try{const response=await fetch(form.dataset.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const data=await response.json().catch(()=>({}));if(!response.ok){errorBox.textContent=data.error||'That did not work. Try again.';submit.disabled=false;return}location.href=data.redirect||'https://platform.bapx.in/'}catch{errorBox.textContent='Network problem. Try again.';submit.disabled=false}});})();</script></body></html>
<style>.auth-form{display:grid;gap:10px;margin-top:24px}.auth-input{background:#0a0a0a;border:1px solid #363a3f;border-radius:8px;color:#fff;padding:12px;font-size:15px;width:100%;box-sizing:border-box}.auth-input:focus{outline:none;border-color:#7d8187}.auth-hint{color:#7d8187;font-size:12px}.auth-submit{display:flex;justify-content:center;border:0;cursor:pointer;font-size:15px}.auth-submit:disabled{opacity:.6;cursor:progress}.auth-divider{display:flex;align-items:center;gap:12px;color:#7d8187;font-size:13px;margin:22px 0 0}.auth-divider::before,.auth-divider::after{content:'';flex:1;height:1px;background:#292c31}.auth-page{min-height:100vh;display:grid;place-items:center;background:#0a0a0a;color:#fff;padding:24px}.auth-card{width:min(520px,100%);border:1px solid var(--hairline);border-radius:8px;padding:32px;background:#191919}.auth-brand img{display:block;width:112px}.mono-label{margin-top:42px}.auth-card h1{font-size:clamp(40px,7vw,64px);font-weight:400;letter-spacing:-.05em;margin:12px 0 20px}.auth-card>p{color:#a9abb1;line-height:1.6}.github-auth{display:flex;justify-content:center;margin-top:28px}.auth-foot{text-align:center;margin-top:28px}.auth-error{color:#ffb4a8;min-height:20px}</style>
