---
import '../../styles/global.css';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Sign in | bapX</title><link rel="icon" type="image/svg+xml" href="/favicon.svg?v=bapx-20260711"/></head><body class="auth-page"><main class="auth-card"><a href="https://bapx.in/" class="auth-brand"><img src="/brand/bapx-logo-main.svg" alt="bapX"/></a><p class="mono-label">WELCOME BACK</p><h1>Sign in.</h1><p>Use your email and password, or continue with GitHub. Either signs you in to the same bapX account and business workspaces.</p><p id="error" class="auth-error" role="alert"></p><form class="auth-form" id="password-form" method="post" action="/api/auth/password/login" data-action="/api/auth/password/login"><input class="auth-input" type="email" name="email" autocomplete="email" placeholder="Email address" required/><input class="auth-input" type="password" name="password" autocomplete="current-password" placeholder="Password" required minlength="12"/><button class="bapx-pill bapx-pill-primary auth-submit" type="submit">Sign in</button></form><p class="auth-divider"><span>or</span></p><a class="bapx-pill bapx-pill-primary github-auth" href="/api/auth/oauth/github">Continue with GitHub</a><p class="auth-foot">New to bapX? <a href="https://bapx.in/signup/">Create your account</a></p></main><script is:inline>const params=new URLSearchParams(location.search);const rawError=params.get('error')||'';const error=/not configured/i.test(rawError)?'GitHub sign-in is temporarily unavailable. Please try again shortly.':rawError;document.querySelector('#error').textContent=error;const returnTo=params.get('returnTo');if(returnTo)document.querySelector('.github-auth').href='/api/auth/oauth/github?returnTo='+encodeURIComponent(returnTo);</script><script is:inline>(()=>{const form=document.querySelector('#password-form');const errorBox=document.querySelector('#error');const search=new URLSearchParams(location.search);const returnTo=search.get('returnTo')||'';form?.addEventListener('submit',async(event)=>{event.preventDefault();errorBox.textContent='';const submit=form.querySelector('.auth-submit');submit.disabled=true;const body=Object.fromEntries(new FormData(form));if(returnTo)body.returnTo=returnTo;try{const response=await fetch(form.dataset.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const data=await response.json().catch(()=>({}));if(!response.ok){errorBox.textContent=data.error||'That did not work. Try again.';submit.disabled=false;return}location.href=data.redirect||'https://platform.bapx.in/'}catch{errorBox.textContent='Network problem. Try again.';submit.disabled=false}});})();</script></body></html>
<style>.auth-form{display:grid;gap:10px;margin-top:24px}.auth-input{background:#0a0a0a;border:1px solid #363a3f;border-radius:8px;color:#fff;padding:12px;font-size:15px;width:100%;box-sizing:border-box}.auth-input:focus{outline:none;border-color:#7d8187}.auth-hint{color:#7d8187;font-size:12px}.auth-submit{display:flex;justify-content:center;border:0;cursor:pointer;font-size:15px}.auth-submit:disabled{opacity:.6;cursor:progress}.auth-divider{display:flex;align-items:center;gap:12px;color:#7d8187;font-size:13px;margin:22px 0 0}.auth-divider::before,.auth-divider::after{content:'';flex:1;height:1px;background:#292c31}</style><style>.auth-page{min-height:100vh;display:grid;place-items:center;background:#0a0a0a;color:#fff;padding:24px}.auth-card{width:min(460px,100%);border:1px solid var(--hairline);border-radius:8px;padding:32px;background:#191919}.auth-brand img{display:block;width:112px}.mono-label{margin-top:42px}.auth-card h1{font-size:40px;font-weight:400;letter-spacing:-.04em;margin:12px 0 20px}.auth-card>p{color:#a9abb1;line-height:1.6}.github-auth{display:flex;justify-content:center;margin-top:28px}.auth-foot{text-align:center;margin-top:28px}.auth-error{color:#ffb4a8;min-height:20px}</style>
