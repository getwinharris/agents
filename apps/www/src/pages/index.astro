---
import "../styles/global.css";
import { channels, ecosystemPublicHref, homepageEcosystemItems } from "../../../ecosystem-catalog";

const navItems = [
  ["Product", "/products/"],
  ["Platform", "https://platform.bapx.in/"],
  ["Docs", "https://docs.bapx.in/"],
  ["Research", "https://blogs.bapx.in/research/"],
  ["Media Hub", "https://mediahub.bapx.in/"],
] as const;

const operatingStages = [
  ["01", "Bring the project", "Import from your tools and capture the context."],
  ["02", "Direct the work", "Define goals, constraints, and how agents should work."],
  ["03", "Verify the result", "Check outputs, run evaluations, and close the loop."],
  ["04", "Ship with evidence", "Publish results with provenance and an audit trail."],
] as const;

const productSurfaces = [
  ["Platform", "Account, billing, keys, connectors, and observability.", "https://platform.bapx.in/"],
  ["Agents", "The customer workspace for people, projects, automations, and agents.", "https://agents.bapx.in/"],
  ["Admin", "The bapX operating surface with whole-system authority.", "https://admin.bapx.in/"],
] as const;

const integrationNames = new Set(["GitHub", "Slack", "Linear", "Sentry", "Shopify"]);
const razorpay = channels.find((item) => item.name === "Razorpay");
const featuredIntegrations = [
  ...homepageEcosystemItems.filter((item) => integrationNames.has(item.name)),
  ...(razorpay ? [razorpay] : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=bapx-20260711" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>bapX — The operating system for people and agents</title>
    <meta name="description" content="Run projects in one hosted workspace where your team and specialist agents plan, build, verify, and ship together." />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href="https://bapx.in/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="bapX" />
    <meta property="og:title" content="bapX — The operating system for people and agents" />
    <meta property="og:description" content="Run projects in one hosted workspace where your team and specialist agents plan, build, verify, and ship together." />
    <meta property="og:url" content="https://bapx.in/" />
    <meta property="og:image" content="https://bapx.in/og3.jpg" />
    <meta property="og:image:alt" content="bapX logo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="bapX — The operating system for people and agents" />
    <meta name="twitter:description" content="One hosted workspace for people, projects, and specialist agents." />
    <meta name="twitter:image" content="https://bapx.in/og3.jpg" />
    <meta name="twitter:image:alt" content="bapX logo" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav class="sticky top-0 z-50 border-b border-[var(--hairline)] bg-[var(--canvas)]/90 backdrop-blur-sm">
      <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-6">
        <div class="flex h-full items-center gap-8">
          <a href="/" aria-label="bapX home"><img src="/brand/bapx-logo-main.svg" alt="bapX" class="h-7 w-auto" /></a>
          <div class="bapx-nav hidden lg:flex h-full items-center gap-7">
            {navItems.map(([label, href]) => <a href={href}>{label}</a>)}
          </div>
        </div>
        <div class="flex items-center gap-3">
          <a href="/login/" class="bapx-pill bapx-pill-primary">Sign in</a>
          <button class="landing-menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="landing-mobile-menu">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          </button>
        </div>
      </div>
      <div id="landing-mobile-menu" class="landing-mobile-menu" hidden>
        {navItems.map(([label, href]) => <a href={href}>{label}</a>)}
      </div>
    </nav>

    <main>
      <section class="landing-hero">
        <div class="section-inner">
          <div class="landing-hero-copy">
            <h1>The operating system for people and agents.</h1>
            <p>Run projects in one hosted workspace where your team and specialist agents plan, build, verify, and ship together.</p>
            <div class="hero-actions">
              <a href="https://platform.bapx.in/" class="bapx-button bapx-button-primary">Open platform</a>
              <a href="#operating-loop" class="bapx-button">See how it works</a>
            </div>
          </div>

          <div class="workspace-preview" aria-label="bapX workspace product preview">
            <div class="workspace-preview-top">
              <span>Workspace</span>
              <strong>Acme operations</strong>
            </div>
            <div class="workspace-preview-body">
              <aside>
                <span class="preview-label">Projects</span>
                <a href="https://agents.bapx.in/">Commerce launch</a>
                <a href="https://agents.bapx.in/">Support operations</a>
                <a href="https://agents.bapx.in/">Product delivery</a>
              </aside>
              <div class="workspace-main">
                <div class="main-agent-row">
                  <div><span class="preview-label">Main agent</span><strong>bapX agent</strong></div>
                  <span class="agent-state">Ready</span>
                </div>
                <div class="workspace-columns">
                  <section><span class="preview-label">Projects</span><strong>Checkout redesign</strong><p>Repository, context, and delivery plan.</p></section>
                  <section><span class="preview-label">Automations</span><strong>Test and verify</strong><p>Review gates and recurring operations.</p></section>
                  <section><span class="preview-label">Browser</span><strong>Live product check</strong><p>Page state, screenshots, and errors.</p></section>
                  <section><span class="preview-label">Review</span><strong>Evidence attached</strong><p>PR, audit trail, and release result.</p></section>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="operating-loop" class="landing-band operating-loop-section">
        <div class="section-inner">
          <h2>One workspace. One operating loop.</h2>
          <div class="operating-rail">
            {operatingStages.map(([step, title, body]) => (
              <article>
                <span>{step}</span>
                <h3>{title}</h3>
                <p>{body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="landing-band product-boundaries">
        <div class="section-inner">
          <h2>The product has clear boundaries.</h2>
          <div class="surface-rail">
            {productSurfaces.map(([title, body, href]) => (
              <a href={href}>
                <span aria-hidden="true"></span>
                <h3>{title}</h3>
                <p>{body}</p>
                <em>Open {title}</em>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="landing-band integrations-band">
        <div class="section-inner">
          <div class="integration-heading">
            <h2>Connect the systems already running your business.</h2>
            <a href="https://docs.bapx.in/ecosystem/">View ecosystem</a>
          </div>
          <div class="integration-rail">
            {featuredIntegrations.map((item) => (
              <a href={ecosystemPublicHref(item)}>
                {item.icon ? <img src={item.icon} alt="" /> : <span aria-hidden="true">{item.name.slice(0, 1)}</span>}
                <strong>{item.name}</strong>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="landing-band landing-pricing">
        <div class="section-inner">
          <div>
            <h2>Hosted operations from ₹500/month.</h2>
            <p>Includes 5 GB workspace storage. Bring your own model and connector credentials.</p>
          </div>
          <a href="/pricing/" class="bapx-button bapx-button-primary">View pricing</a>
        </div>
      </section>
    </main>

    <footer class="page-footer">
      <div class="section-inner"><span>bapX — The operating system for people and agents.</span><span>&copy; {new Date().getFullYear()}</span></div>
    </footer>
    <script is:inline>
      const menuToggle = document.querySelector('.landing-menu-toggle');
      const mobileMenu = document.querySelector('#landing-mobile-menu');
      const setMenuOpen = (open) => {
        mobileMenu.hidden = !open;
        menuToggle.setAttribute('aria-expanded', String(open));
        menuToggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      };
      menuToggle.addEventListener('click', () => setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true'));
      mobileMenu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          setMenuOpen(false);
          menuToggle.focus();
        }
      });
    </script>
  </body>
</html>
