---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Contact | bapX</title>
    <meta name="description" content="Contact bapX or continue a scoped MediaHub enterprise-services conversation." />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href="https://bapx.in/contact/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=bapx-20260711" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav class="sticky top-0 z-50 border-b border-[var(--hairline)] bg-[var(--canvas)]/80 backdrop-blur-sm">
      <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-6">
        <div class="flex h-full items-center gap-8">
          <a href="/" class="flex items-center gap-2">
            <img src="/brand/bapx-logo-main.svg" alt="bapX" class="h-7 w-auto" />
          </a>
          <div class="bapx-nav hidden lg:flex h-full items-center gap-7">
            <a href="/">Home</a>
            <a href="https://docs.bapx.in/getting-started/quickstart/">Docs</a>
            <a href="/mediahub/">Media Hub</a>
            <a href="https://blogs.bapx.in/">Blog</a>
            <a href="/products/">Products</a>
            <a href="/contact/" class="active">Contact</a>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <a href="https://agents.bapx.in/" class="bapx-pill">Agents</a>
          <a href="/login/" class="bapx-pill bapx-pill-primary">Sign in</a>
        </div>
      </div>
    </nav>

    <main class="page-section page-header" style="max-width: 680px; margin: 0 auto;">
      <span id="contact-label" class="mono-label">Contact</span>
      <h1 id="contact-heading" class="display-xl" style="margin-top: 1.75rem;">Get in touch.</h1>
      <p id="contact-intro" class="body-lg" style="margin-top: 1.5rem; max-width: 620px;">Have a project in mind, interested in bapX, or want to discuss a direct MediaHub engagement? Reach out below.</p>

      <section id="contact-scope" class="contact-scope-summary" aria-label="Selected MediaHub scope" hidden>
        <div><span>Primary outcome</span><strong data-scope-value="service"></strong></div>
        <div><span>Current systems</span><strong data-scope-value="systems"></strong></div>
        <div><span>Timeline</span><strong data-scope-value="timeline"></strong></div>
        <a id="contact-scope-email" href="mailto:hello@bapx.in" class="bapx-button bapx-button-accent">Email this brief</a>
        <a href="https://mediahub.bapx.in/#scope">Change selections</a>
      </section>

      <div class="card-grid-2" style="margin-top: 3.375rem; max-width: 560px;">
        <div class="card">
          <h2 class="display-md">Email</h2>
          <p class="body-sm" style="margin-top: .75rem;"><a id="contact-email" href="mailto:hello@bapx.in" style="color: var(--ink);">hello@bapx.in</a></p>
        </div>
        <div class="card">
          <h2 class="display-md">X / Twitter</h2>
          <p class="body-sm" style="margin-top: .75rem;"><a href="https://x.com/bapx_ai" target="_blank" rel="noopener noreferrer" style="color: var(--ink);">@bapx_ai</a></p>
        </div>
        <div class="card">
          <h2 class="display-md">GitHub</h2>
          <p class="body-sm" style="margin-top: .75rem;"><a href="https://github.com/getwinharris/agents" target="_blank" rel="noopener noreferrer" style="color: var(--ink);">github.com/getwinharris/agents</a></p>
        </div>
      </div>
    </main>

    <footer class="page-footer">
      <div class="section-inner">
        <span>bapX — The operating system for people and agents.</span>
        <span>&copy; {new Date().getFullYear()}</span>
      </div>
    </footer>
    <script is:inline>
      const params = new URLSearchParams(window.location.search);
      const scope = {
        service: params.get('service')?.trim() || '',
        systems: params.get('systems')?.trim() || '',
        timeline: params.get('timeline')?.trim() || '',
      };
      if (scope.service && scope.systems && scope.timeline) {
        document.querySelector('#contact-label').textContent = 'MediaHub scope';
        document.querySelector('#contact-heading').textContent = 'Continue the scoped conversation.';
        document.querySelector('#contact-intro').textContent = 'Your selections are ready to include in an email to the bapX MediaHub team. Add the operating workflow, people, integrations, constraints, and production outcome before sending.';
        Object.entries(scope).forEach(([key, value]) => {
          document.querySelector(`[data-scope-value="${key}"]`).textContent = value;
        });
        const body = `Primary outcome: ${scope.service}\nCurrent systems: ${scope.systems}\nTimeline: ${scope.timeline}\n\nPlease add the workflow, users, integrations, constraints, and production outcome.`;
        const mailto = `mailto:hello@bapx.in?subject=${encodeURIComponent(`MediaHub scope: ${scope.service}`)}&body=${encodeURIComponent(body)}`;
        document.querySelector('#contact-scope-email').href = mailto;
        document.querySelector('#contact-email').href = mailto;
        document.querySelector('#contact-scope').hidden = false;
      }
    </script>
  </body>
</html>
