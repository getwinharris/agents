---
import '../../styles/global.css';
import { customerEcosystemGroups } from '../../lib/customer-ecosystem';
// Platform navigation. An item with `id` scrolls to a real, implemented section
// on this page. An item with `pending` has no implementation behind it, so it
// renders as a non-interactive entry instead of an anchor that silently does
// nothing. Only give an item an `id` in the same change that ships its section.
//   Billing       -> issue #83, no payment code exists (`rg razorpay` finds nothing).
//   API keys      -> PR #111 adds /api/platform/api-keys; flip to id:'api-keys' on merge.
//   MCP           -> issue #85, https://api.bapx.in/mcp is unrouted and returns 404.
//   Observability -> no per-account telemetry surface; only the developer guide.
//   Settings      -> no account settings endpoint exists.
const nav=[
	{label:'Account',id:'account'},
	{label:'Billing',pending:'Subscription and invoice management is not built yet. Current plan and storage pricing is published in the docs.',docs:'https://docs.bapx.in/platform/billing/'},
	{label:'Connectors',id:'connectors'},
	{label:'API keys',pending:'Customer API keys ship with the bapX API plane, which is not routed yet.'},
	{label:'MCP',pending:'The hosted MCP gateway is not routed yet, so there are no MCP servers to manage here.'},
	{label:'Observability',pending:'Per-account traces and error data are not in Platform yet. Instrumenting your own agents is documented.',docs:'https://docs.bapx.in/guide/observability/'},
	{label:'Settings',pending:'Editable account settings are not built yet. Your current account details are shown under Account.'},
];
const pendingNav=nav.filter((item)=>item.pending);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Platform | bapX</title><link rel="icon" href="/favicon.svg"/></head><body><div class="platform-shell">
<aside><a class="brand brand-lockup" href="https://bapx.in/"><img src="/brand/bapx-logo-main.svg" alt="bapX"/><span>Platform</span></a><div class="switcher"><span>Workspace</span><strong id="workspace-name">Loading…</strong></div><nav>{nav.map((item,i)=>item.id?<a class={i===0?'active':undefined} href={`#${item.id}`}>{item.label}</a>:<span class="nav-pending" aria-disabled="true" title={item.pending}>{item.label}<em>Soon</em></span>)}</nav><div class="profile"><span>BX</span><div><strong id="account-name">Account owner</strong><small id="account-email">Account</small></div></div></aside>
<main><header><div><p class="mono-label">PLATFORM</p><h1>Settings and connectors</h1></div><a class="bapx-pill bapx-pill-primary" href="https://agents.bapx.in/">Open Agents</a></header>
<section class="metrics"><article><span>Plan</span><strong>₹500</strong><small>/month</small></article><article><span>Included storage</span><strong>5 GB</strong></article><article><span>Storage scale</span><strong>₹100</strong><small>/GB/month</small></article><article><span>Limit</span><strong>100 GB</strong></article></section>
<section class="panel"><div class="panel-head"><div><h2>Control plane</h2><p>Review your account and configure business connectors. Billing, API access, MCP, and observability are not available here yet. Work happens in Admin or Agents.</p></div><a class="bapx-pill" href="https://docs.bapx.in/platform/overview/">Docs</a></div></section>
<section class="panel" id="account"><div class="panel-head"><div><h2>Account</h2><p>The bapX identity this browser is signed in as. Every account owns one workspace, and projects live inside it.</p></div><button class="bapx-pill" id="signout" type="button">Sign out</button></div>
<dl class="account-facts"><div><dt>Name</dt><dd id="fact-name">Loading…</dd></div><div><dt>Email</dt><dd id="fact-email">Loading…</dd></div><div><dt>Username</dt><dd id="fact-username">Loading…</dd></div><div><dt>Workspace</dt><dd id="fact-workspace">Loading…</dd></div><div><dt>Member since</dt><dd id="fact-created">Loading…</dd></div><div><dt>Sign-in</dt><dd id="fact-providers">Loading…</dd></div></dl></section>
<section class="panel" id="connectors"><div class="panel-head"><div><h2>Business connectors</h2><p>Configure connections here. Agents receives only connections authorized for its business workspace.</p></div><a class="bapx-pill" href="https://docs.bapx.in/ecosystem/">Connector docs</a></div>
<div class="connector-groups">{customerEcosystemGroups.map((group)=><section><h3>{group.title}</h3><div class="connector-grid">{group.entries.map(({item})=><article class="connector-card"><span class="connector-mark" style={`--connector-bg:${item.background}`}>{item.icon?<img src={item.icon} alt=""/>:item.name.slice(0,2)}</span><div><strong>{item.name}</strong><small>Available</small></div>{item.name==='OpenAI'?<button class="bapx-pill connect-openai" type="button">Connect with device OAuth</button>:<a class="bapx-pill" href={item.href}>Configure</a>}</article>)}</div></section>)}</div><div id="openai-consent" class="consent" hidden></div></section>
<section class="lower"><article class="panel"><h2>Agents and Admin access</h2><p>Agents uses customer business connections. Admin uses the same operating model for `/root/bapx.in`, plus bapX repository and user management, without inheriting customer secrets.</p><a class="bapx-pill" href="https://agents.bapx.in/threads">Open task oversight</a></article><article class="panel"><h2>Observability and quality</h2><p>Sentry, OpenTelemetry, Braintrust, and Vitest provide errors, traces, and evaluation evidence.</p><a class="bapx-pill" href="https://docs.bapx.in/guide/observability/">Read the guide</a></article></section>
<section class="panel"><div class="panel-head"><div><h2>Not available yet</h2><p>These areas are named in the navigation but have no implementation behind them today. They are listed here rather than shown as links that do nothing.</p></div></div>
<ul class="pending-list">{pendingNav.map((item)=><li><strong>{item.label}</strong><span>{item.pending}</span>{item.docs?<a class="bapx-pill" href={item.docs}>Docs</a>:null}</li>)}</ul></section>
</main></div>
<script is:inline>function setText(selector,value){const node=document.querySelector(selector);if(node)node.textContent=value}
fetch('/api/auth/session').then(r=>r.ok?r.json():Promise.reject()).then(({account})=>{const workspace=account.primaryBusinessSlug||'workspace';const providers=(Array.isArray(account.providers)?account.providers:[]).map((provider)=>provider&&provider.name).filter(Boolean);let created='Unknown';if(account.createdAt){const parsed=new Date(account.createdAt);if(!Number.isNaN(parsed.getTime()))created=parsed.toLocaleDateString()}
setText('#account-name',account.name);setText('#account-email',account.email);setText('#workspace-name',workspace);
setText('#fact-name',account.name);setText('#fact-email',account.email);setText('#fact-username',account.username||'Unknown');setText('#fact-workspace',workspace);setText('#fact-created',created);setText('#fact-providers',providers.length?providers.join(', '):'Not recorded');}).catch(()=>location.href='https://bapx.in/login/');
document.querySelector('#signout')?.addEventListener('click',async()=>{await fetch('/api/auth/logout',{method:'POST'}).catch(()=>{});location.href='https://bapx.in/login/'});
document.querySelector('.connect-openai')?.addEventListener('click',async()=>{const output=document.querySelector('#openai-consent');output.hidden=false;output.textContent='Starting secure OpenAI device sign-in…';const response=await fetch('/api/platform/connectors/openai-codex/device',{method:'POST'});if(!response.ok){output.textContent='OpenAI sign-in is temporarily unavailable.';return}const flow=await response.json();output.innerHTML=`Open <a href="${flow.verificationUri}" target="_blank" rel="noreferrer">${flow.verificationUri}</a> on your device and enter <strong>${flow.userCode}</strong>. bapX never asks for an API key.`})</script></body></html>
<style>
body{margin:0;background:#0a0a0a;color:#fff}.platform-shell{display:grid;grid-template-columns:260px 1fr;min-height:100vh}aside{border-right:1px solid #212327;padding:24px 16px;display:flex;flex-direction:column}.brand{margin:0 10px 28px}.brand img{width:112px;height:auto}.switcher{background:#191919;color:#fff;border:1px solid #363a3f;border-radius:8px;padding:12px;text-align:left;display:flex;justify-content:space-between;gap:10px}.switcher span{color:#7d8187}.switcher strong{font-weight:400;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}nav{display:grid;gap:3px;margin-top:20px}nav a{padding:10px 12px;border-radius:8px;color:#dadbdf}nav a.active{background:#1a1c20;color:#fff}.nav-pending{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px 12px;border-radius:8px;color:#6b6f75;cursor:not-allowed}.nav-pending em{font-style:normal;font-size:11px;letter-spacing:.04em;text-transform:uppercase;color:#7d8187;border:1px solid #2f3339;border-radius:999px;padding:2px 7px}.profile{margin-top:auto;display:flex;gap:12px;align-items:center;padding:12px}.profile>span{display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:#fff;color:#0a0a0a}.profile div{display:grid}.profile small,.connector-card small{color:#7d8187}main{padding:44px 5vw}main>header,.panel-head{display:flex;justify-content:space-between;align-items:center;gap:24px}h1{font-size:48px;font-weight:400;letter-spacing:-.04em;margin:8px 0 34px}.metrics{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid #212327;border-radius:8px}.metrics article{padding:24px;border-right:1px solid #212327}.metrics article:last-child{border:0}.metrics span{color:#7d8187}.metrics strong{display:block;font-size:36px;font-weight:400;margin-top:16px}.panel{border:1px solid #212327;border-radius:8px;padding:24px;margin-top:24px;background:#111}.panel h2,.connector-groups h3{font-weight:400;margin:0 0 8px}.panel p{color:#7d8187}.account-facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:20px 0 0}.account-facts div{border:1px solid #292c31;border-radius:8px;padding:12px}.account-facts dt{color:#7d8187;font-size:12px}.account-facts dd{margin:6px 0 0;word-break:break-word}.pending-list{list-style:none;margin:20px 0 0;padding:0;display:grid;gap:8px}.pending-list li{display:flex;align-items:center;gap:12px;border:1px solid #292c31;border-radius:8px;padding:12px}.pending-list strong{min-width:118px;font-weight:400}.pending-list span{flex:1;color:#7d8187;font-size:14px}.connector-groups{display:grid;gap:24px;margin-top:24px}.connector-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.connector-card{display:flex;align-items:center;gap:12px;border:1px solid #292c31;border-radius:8px;padding:12px}.connector-card>div{display:grid;flex:1}.connector-mark{width:36px;height:36px;display:grid;place-items:center;border-radius:8px;background:var(--connector-bg)}.connector-mark img{max-width:24px;max-height:24px}.consent{margin-top:20px;padding:16px;border:1px solid #4d815f;border-radius:8px}.consent a{color:#8fcba1}.lower{display:grid;grid-template-columns:1fr 1fr;gap:24px}.lower .panel{min-height:150px}@media(max-width:800px){.platform-shell{grid-template-columns:1fr}aside{display:none}main{padding:24px}.metrics,.connector-grid,.lower,.account-facts{grid-template-columns:1fr}.metrics article{border-bottom:1px solid #212327}.pending-list li{flex-direction:column;align-items:flex-start}}
</style>
