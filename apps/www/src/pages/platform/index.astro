---
import '../../styles/global.css';
import { customerEcosystemGroups } from '../../lib/customer-ecosystem';
const nav=['Account','Billing','Connectors','API keys','MCP','Observability','Settings'];
const slugOf=(href)=>String(href).replace(/\/$/,'').split('/').at(-1)??'';
const siteNav=[['Home','https://bapx.in/'],['Products','https://bapx.in/products/'],['Pricing','https://bapx.in/pricing/'],['Docs','https://docs.bapx.in/'],['Research','https://blogs.bapx.in/research/'],['Releases','https://blogs.bapx.in/release/'],['Media Hub','https://mediahub.bapx.in/']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Platform | bapX</title><link rel="icon" href="/favicon.svg"/></head><body><nav class="site-header"><div class="site-header-inner"><div class="site-header-left"><a href="https://bapx.in/" class="site-brand"><img src="/brand/bapx-logo-main.svg" alt="bapX"/></a><div class="bapx-nav site-links">{siteNav.map(([label,href])=><a href={href}>{label}</a>)}</div></div><div class="site-header-actions"><a href="https://agents.bapx.in/" class="bapx-pill">Agents</a><button type="button" class="bapx-pill bapx-pill-primary" id="signout">Sign out</button></div></div></nav><div class="platform-shell">
<aside><a class="brand brand-lockup" href="https://bapx.in/"><img src="/brand/bapx-logo-main.svg" alt="bapX"/><span>Platform</span></a><button class="switcher">Account settings <span>⌄</span></button><nav>{nav.map((item,i)=><a class={i===0?'active':''} href={`#${item.toLowerCase().replaceAll(' ','-')}`}>{item}</a>)}</nav><div class="profile"><span>BX</span><div><strong id="account-name">Account owner</strong><small id="account-email">Account</small></div></div></aside>
<main><header><div><p class="mono-label">PLATFORM</p><h1>Settings and connectors</h1></div><a class="bapx-pill bapx-pill-primary" href="https://agents.bapx.in/">Open Agents</a></header>
<section class="metrics"><article><span>Plan</span><strong>₹500</strong><small>/month</small></article><article><span>Included storage</span><strong>5 GB</strong></article><article><span>Storage scale</span><strong>₹100</strong><small>/GB/month</small></article><article><span>Limit</span><strong>100 GB</strong></article></section>
<section class="panel"><div class="panel-head"><div><h2>Control plane</h2><p>Manage account settings, billing, connectors, API access, MCPs, and observability. Work happens in Admin or Agents.</p></div><a class="bapx-pill" href="https://docs.bapx.in/platform/overview/">Docs</a></div></section>
<section class="panel" id="api-keys"><div class="panel-head"><div><h2>API access</h2><p>One OpenAI-compatible endpoint for every model your business connects. You bring your own provider credentials — bapX routes, meters, and audits the calls. Your quota is consumed under your own agreement with each provider.</p></div><a class="bapx-pill" href="https://docs.bapx.in/platform/api/">API docs</a></div>
<div class="api-keys"><div class="api-keys-head"><p class="mono-label">YOUR KEYS</p><button class="bapx-pill bapx-pill-primary" id="create-key" type="button">Create API key</button></div><p class="api-reveal" id="key-reveal" hidden></p><ul class="key-list" id="key-list"><li class="key-empty">Loading…</li></ul></div>
<dl class="api-facts"><div><dt>Base URL</dt><dd><code>https://api.bapx.in/v1</code> <small>(pending)</small></dd></div><div><dt>Compatibility</dt><dd>OpenAI Chat Completions and Models</dd></div><div><dt>Credentials</dt><dd>Bring your own provider keys</dd></div></dl></section>
<section class="panel" id="connectors"><div class="panel-head"><div><h2>Business connectors</h2><p>Configure connections here. Agents receives only connections authorized for its business workspace.</p></div><a class="bapx-pill" href="https://docs.bapx.in/ecosystem/">Connector docs</a></div>
<p class="connector-note" id="connector-note" hidden></p>
<div class="connector-groups">{customerEcosystemGroups.map((group)=><section><h3>{group.title}</h3><div class="connector-grid">{group.entries.map(({item})=><article class="connector-card"><span class="connector-mark" style={`--connector-bg:${item.background}`}>{item.icon?<img src={item.icon} alt=""/>:item.name.slice(0,2)}</span><div><strong>{item.name}</strong><small class="connector-state" data-state-for={slugOf(item.href)}>Not connected</small></div>{slugOf(item.href)==='openai'?<button class="bapx-pill connect-openai" type="button">Connect with device OAuth</button>:<button class="bapx-pill connector-connect" type="button" data-slug={slugOf(item.href)} data-name={item.name} data-category={group.category} data-docs={item.href}>Connect</button>}</article>)}</div></section>)}</div><div id="openai-consent" class="consent" hidden></div></section>
<section class="lower"><article class="panel"><h2>Agents and Admin access</h2><p>Agents uses customer business connections. Admin uses the same operating model for `/root/bapx.in`, plus bapX repository and user management, without inheriting customer secrets.</p><a class="bapx-pill" href="https://agents.bapx.in/threads">Open task oversight</a></article><article class="panel"><h2>Observability and quality</h2><p>Sentry, OpenTelemetry, Braintrust, and Vitest provide errors, traces, and evaluation evidence.</p><a class="bapx-pill" href="https://docs.bapx.in/guide/observability/">Open observability</a></article></section>
</main></div>
<script is:inline>fetch('/api/auth/session').then(r=>r.ok?r.json():Promise.reject()).then(({account})=>{document.querySelector('#account-name').textContent=account.name;document.querySelector('#account-email').textContent=account.email;}).catch(()=>{location.href='https://bapx.in/login/?returnTo='+encodeURIComponent(location.href)});document.querySelector('.connect-openai')?.addEventListener('click',async()=>{const output=document.querySelector('#openai-consent');output.hidden=false;output.textContent='Starting secure OpenAI device sign-in…';const response=await fetch('/api/platform/connectors/openai-codex/device',{method:'POST'});if(!response.ok){output.textContent='OpenAI sign-in is temporarily unavailable.';return}const flow=await response.json();let uri=null;try{const parsed=new URL(flow.verificationUri);if(parsed.protocol==='https:')uri=parsed.href}catch{}output.textContent='';if(!uri){output.textContent='The provider did not return a valid verification link. Try again.';return}output.append('Open ');const link=document.createElement('a');link.href=uri;link.target='_blank';link.rel='noreferrer';link.textContent=uri;output.append(link,' on your device and enter ');const code=document.createElement('strong');code.textContent=String(flow.userCode??'');output.append(code,'. bapX never asks for an API key.')});
const keyList=document.querySelector('#key-list');const reveal=document.querySelector('#key-reveal');
function renderKeys(keys){if(!keys.length){keyList.innerHTML='<li class="key-empty">No API keys yet. Create one to call https://api.bapx.in/v1</li>';return}keyList.innerHTML='';for(const key of keys){const row=document.createElement('li');row.className='key-row';const meta=document.createElement('div');const name=document.createElement('strong');name.textContent=key.name;const detail=document.createElement('small');detail.textContent=`${key.prefix}\u2026 \u00b7 created ${new Date(key.createdAt).toLocaleDateString()}${key.lastUsedAt?` \u00b7 last used ${new Date(key.lastUsedAt).toLocaleDateString()}`:' \u00b7 never used'}`;meta.append(name,detail);const revoke=document.createElement('button');revoke.type='button';revoke.className='bapx-pill key-revoke';revoke.textContent='Revoke';revoke.addEventListener('click',async()=>{if(!confirm(`Revoke "${key.name}"? Any application using it stops working immediately.`))return;const removed=await fetch(`/api/platform/api-keys/${encodeURIComponent(key.id)}`,{method:'DELETE'});if(!removed.ok){reveal.hidden=false;reveal.textContent=`Could not revoke "${key.name}". It is still active.`;return}loadKeys()});row.append(meta,revoke);keyList.append(row)}}
async function loadKeys(){try{const response=await fetch('/api/platform/api-keys');if(!response.ok)throw new Error();const {keys}=await response.json();renderKeys(keys)}catch{keyList.innerHTML='<li class="key-empty">API keys are unavailable right now.</li>'}}
document.querySelector('#create-key')?.addEventListener('click',async()=>{const name=prompt('Name this key (for example: production server)','Default key');if(name===null)return;const response=await fetch('/api/platform/api-keys',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name})});if(!response.ok){reveal.hidden=false;reveal.textContent='Could not create the key. Try again.';return}const {secret}=await response.json();reveal.hidden=false;reveal.textContent=`Copy this key now \u2014 it is shown once and never again: ${secret}`;loadKeys()});
loadKeys();
const connState=new Map();
function askCredential(button,name,docs){return new Promise((resolve)=>{
const card=button.closest('.connector-card');const existing=card.querySelector('.credential-form');if(existing){existing.querySelector('input').focus();resolve(null);return}
const form=document.createElement('form');form.className='credential-form';
const field=document.createElement('input');field.type='password';field.required=true;field.autocomplete='off';field.name='credential';field.placeholder=`${name} API key or token`;field.setAttribute('aria-label',`${name} credential`);
const save=document.createElement('button');save.type='submit';save.className='bapx-pill bapx-pill-primary';save.textContent='Save';
const cancel=document.createElement('button');cancel.type='button';cancel.className='bapx-pill';cancel.textContent='Cancel';
const help=document.createElement('small');help.textContent='Encrypted before storage and never shown again.';
const link=document.createElement('a');link.href=docs;link.textContent=' Where to find it';help.append(link);
form.append(field,save,cancel,help);card.append(form);field.focus();
const close=(value)=>{form.remove();resolve(value)};
form.addEventListener('submit',(event)=>{event.preventDefault();close(field.value.trim()||null)});
cancel.addEventListener('click',()=>close(null));
field.addEventListener('keydown',(event)=>{if(event.key==='Escape')close(null)});
})}
function paintConnectors(){for(const card of document.querySelectorAll('.connector-card')){const label=card.querySelector('.connector-state');if(!label)continue;const button=card.querySelector('.connector-connect');const slug=button?button.dataset.slug:label.dataset.stateFor;if(!button){const oauthConn=connState.get(slug);label.textContent=oauthConn?`Connected \u00b7 ${oauthConn.hint}`:'Not connected';label.classList.toggle('is-connected',Boolean(oauthConn));continue}const connection=connState.get(slug);if(connection){label.textContent=`Connected \u00b7 ${connection.hint}`;label.classList.add('is-connected');button.textContent='Disconnect';button.classList.add('is-disconnect')}else{label.textContent='Not connected';label.classList.remove('is-connected');button.textContent='Connect';button.classList.remove('is-disconnect')}}}
async function loadConnections(){try{const response=await fetch('/api/platform/connections');if(!response.ok)throw new Error();const {connections,configured}=await response.json();connState.clear();for(const connection of connections)connState.set(connection.slug,connection);paintConnectors();const note=document.querySelector('#connector-note');if(note&&!configured){note.hidden=false;note.textContent='Connector credential storage is not configured on this server, so connections cannot be saved yet.'}}catch{const note=document.querySelector('#connector-note');if(note){note.hidden=false;note.textContent='Connection status is unavailable right now. Reload before changing a connector \u2014 a service may already be connected.'}}}
document.querySelector('.connector-groups')?.addEventListener('click',async(event)=>{const button=event.target.closest('.connector-connect');if(!button)return;const {slug,name,category,docs}=button.dataset;const existing=connState.get(slug);
if(existing){if(!confirm(`Disconnect ${name}? Agents lose access to it immediately.`))return;button.disabled=true;await fetch(`/api/platform/connections/${encodeURIComponent(existing.id)}`,{method:'DELETE'});button.disabled=false;await loadConnections();return}
const credential=await askCredential(button,name,docs);if(!credential)return;button.disabled=true;const response=await fetch('/api/platform/connections',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({slug,name,category,credential})});button.disabled=false;if(!response.ok){const {error}=await response.json().catch(()=>({error:'Could not save the connection.'}));alert(error||'Could not save the connection.');return}await loadConnections()});
loadConnections();
document.querySelector('#signout')?.addEventListener('click',async()=>{await fetch('/api/auth/logout',{method:'POST'});location.href='https://bapx.in/login/'});</script></body></html>
<style>
body{margin:0;background:#0a0a0a;color:#fff}.platform-shell{display:grid;grid-template-columns:260px 1fr;min-height:100vh}aside{border-right:1px solid #212327;padding:24px 16px;display:flex;flex-direction:column}.brand{margin:0 10px 28px}.brand img{width:112px;height:auto}.switcher{background:#191919;color:#fff;border:1px solid #363a3f;border-radius:8px;padding:12px;text-align:left;display:flex;justify-content:space-between}nav{display:grid;gap:3px;margin-top:20px}nav a{padding:10px 12px;border-radius:8px;color:#dadbdf}nav a.active{background:#1a1c20;color:#fff}.profile{margin-top:auto;display:flex;gap:12px;align-items:center;padding:12px}.profile>span{display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:#fff;color:#0a0a0a}.profile div{display:grid}.profile small,.connector-card small{color:#7d8187}main{padding:44px 5vw}main>header,.panel-head{display:flex;justify-content:space-between;align-items:center;gap:24px}h1{font-size:48px;font-weight:400;letter-spacing:-.04em;margin:8px 0 34px}.metrics{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid #212327;border-radius:8px}.metrics article{padding:24px;border-right:1px solid #212327}.metrics article:last-child{border:0}.metrics span{color:#7d8187}.metrics strong{display:block;font-size:36px;font-weight:400;margin-top:16px}.panel{border:1px solid #212327;border-radius:8px;padding:24px;margin-top:24px;background:#111}.panel h2,.connector-groups h3{font-weight:400;margin:0 0 8px}.panel p{color:#7d8187}.connector-groups{display:grid;gap:24px;margin-top:24px}.connector-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.connector-card{display:flex;align-items:center;gap:12px;border:1px solid #292c31;border-radius:8px;padding:12px}.connector-card>div{display:grid;flex:1}.connector-mark{width:36px;height:36px;display:grid;place-items:center;border-radius:8px;background:var(--connector-bg)}.connector-mark img{max-width:24px;max-height:24px}.site-header{position:sticky;top:0;z-index:50;border-bottom:1px solid #212327;background:rgba(10,10,10,.85);backdrop-filter:blur(6px)}.site-header-inner{display:flex;height:56px;align-items:center;justify-content:space-between;padding:0 24px;gap:24px}.site-header-left{display:flex;align-items:center;gap:28px;min-width:0}.site-brand img{height:26px;width:auto;display:block}.site-links{display:flex;align-items:center;gap:24px}.site-links a{color:#dadbdf;font-size:14px;white-space:nowrap}.site-links a:hover{color:#fff}.site-header-actions{display:flex;align-items:center;gap:10px}.api-keys{margin-top:20px;padding:16px;border:1px solid #363a3f;border-radius:8px;background:#141414}.api-keys-head{display:flex;align-items:center;justify-content:space-between;gap:16px}.api-keys-head .mono-label{margin:0}.api-reveal{margin:14px 0 0;padding:12px;border:1px solid #4d815f;border-radius:8px;background:#0f1a13;word-break:break-all;font-family:ui-monospace,monospace;font-size:13px}.key-list{list-style:none;margin:14px 0 0;padding:0;display:grid;gap:8px}.key-row{display:flex;align-items:center;justify-content:space-between;gap:16px;border:1px solid #292c31;border-radius:8px;padding:12px}.key-row div{display:grid;min-width:0}.key-row small{color:#7d8187}.key-empty{color:#7d8187;font-size:14px}@media(max-width:900px){.site-links{overflow-x:auto;gap:16px;-webkit-overflow-scrolling:touch;scrollbar-width:none}.site-links::-webkit-scrollbar{display:none}.site-header-inner{gap:12px}.site-header-left{flex:1;min-width:0}}.api-facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:16px 0 0}.api-facts div{border:1px solid #292c31;border-radius:8px;padding:12px}.api-facts dt{color:#7d8187;font-size:12px}.api-facts dd{margin:6px 0 0}.api-facts code{background:#0a0a0a;border:1px solid #292c31;border-radius:4px;padding:2px 6px;font-size:13px}.api-facts small{color:#7d8187}.credential-form{flex-basis:100%;display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:10px;padding-top:10px;border-top:1px solid #292c31}.credential-form input{flex:1;min-width:180px;background:#0a0a0a;border:1px solid #363a3f;border-radius:8px;color:#fff;padding:9px 12px;font-size:14px}.credential-form small{flex-basis:100%;color:#7d8187;font-size:12px}.credential-form a{color:#8fcba1;margin-left:4px}.connector-state.is-connected{color:#8fcba1}.connector-connect.is-disconnect{border-color:#5a3b3b}.connector-note{margin:16px 0 0;padding:12px;border:1px solid #5a4a2a;border-radius:8px;color:#e0c98f;font-size:14px}.consent{margin-top:20px;padding:16px;border:1px solid #4d815f;border-radius:8px}.consent a{color:#8fcba1}.lower{display:grid;grid-template-columns:1fr 1fr;gap:24px}.lower .panel{min-height:150px}@media(max-width:800px){.platform-shell{grid-template-columns:1fr}aside{position:sticky;top:56px;z-index:40;flex-direction:row;align-items:center;gap:12px;overflow-x:auto;border-right:0;border-bottom:1px solid #212327;padding:10px 16px;background:#0a0a0a}aside .brand,aside .switcher,aside .profile{display:none}aside nav{display:flex;grid-auto-flow:column;gap:6px}aside nav a{white-space:nowrap;padding:8px 12px;font-size:14px}main{padding:24px}.metrics,.connector-grid,.lower,.api-facts{grid-template-columns:1fr}.metrics article{border-bottom:1px solid #212327}.api-keys-head{flex-direction:column;align-items:flex-start;gap:12px}.key-row{flex-direction:column;align-items:flex-start}}
</style>
