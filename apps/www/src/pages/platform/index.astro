---
import '../../styles/global.css';
import { customerEcosystemGroups } from '../../lib/customer-ecosystem';
const nav=['Account','Billing','Connectors','API keys','MCP','Observability','Settings'];
const siteNav=[['Home','https://bapx.in/'],['Products','https://bapx.in/products/'],['Pricing','https://bapx.in/pricing/'],['Docs','https://docs.bapx.in/'],['Research','https://blogs.bapx.in/research/'],['Releases','https://blogs.bapx.in/release/'],['Media Hub','https://mediahub.bapx.in/']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Platform | bapX</title><link rel="icon" href="/favicon.svg"/></head><body><nav class="site-header"><div class="site-header-inner"><div class="site-header-left"><a href="https://bapx.in/" class="site-brand"><img src="/brand/bapx-logo-main.svg" alt="bapX"/></a><div class="bapx-nav site-links">{siteNav.map(([label,href])=><a href={href}>{label}</a>)}</div></div><div class="site-header-actions"><a href="https://agents.bapx.in/" class="bapx-pill">Agents</a><a href="/api/auth/logout" class="bapx-pill bapx-pill-primary" id="signout">Sign out</a></div></div></nav><div class="platform-shell">
<aside><a class="brand brand-lockup" href="https://bapx.in/"><img src="/brand/bapx-logo-main.svg" alt="bapX"/><span>Platform</span></a><button class="switcher">Account settings <span>⌄</span></button><nav>{nav.map((item,i)=><a class={i===0?'active':''} href={`#${item.toLowerCase().replaceAll(' ','-')}`}>{item}</a>)}</nav><div class="profile"><span>BX</span><div><strong id="account-name">Account owner</strong><small id="account-email">Account</small></div></div></aside>
<main><header><div><p class="mono-label">PLATFORM</p><h1>Settings and connectors</h1></div><a class="bapx-pill bapx-pill-primary" href="https://agents.bapx.in/">Open Agents</a></header>
<section class="metrics"><article><span>Plan</span><strong>₹500</strong><small>/month</small></article><article><span>Included storage</span><strong>5 GB</strong></article><article><span>Storage scale</span><strong>₹100</strong><small>/GB/month</small></article><article><span>Limit</span><strong>100 GB</strong></article></section>
<section class="panel"><div class="panel-head"><div><h2>Control plane</h2><p>Manage account settings, billing, connectors, API access, MCPs, and observability. Work happens in Admin or Agents.</p></div><a class="bapx-pill" href="https://docs.bapx.in/platform/overview/">Docs</a></div></section>
<section class="panel" id="api-keys"><div class="panel-head"><div><h2>API access</h2><p>One OpenAI-compatible endpoint for every model your business connects. You bring your own provider credentials — bapX routes, meters, and audits the calls. Your quota is consumed under your own agreement with each provider.</p></div><a class="bapx-pill" href="https://docs.bapx.in/platform/api/">API docs</a></div>
<div class="api-keys"><div class="api-keys-head"><p class="mono-label">YOUR KEYS</p><button class="bapx-pill bapx-pill-primary" id="create-key" type="button">Create API key</button></div><p class="api-reveal" id="key-reveal" hidden></p><ul class="key-list" id="key-list"><li class="key-empty">Loading…</li></ul></div>
<dl class="api-facts"><div><dt>Base URL</dt><dd><code>https://api.bapx.in/v1</code> <small>(pending)</small></dd></div><div><dt>Compatibility</dt><dd>OpenAI Chat Completions and Models</dd></div><div><dt>Credentials</dt><dd>Bring your own provider keys</dd></div></dl></section>
<section class="panel" id="connectors"><div class="panel-head"><div><h2>Business connectors</h2><p>Configure connections here. Agents receives only connections authorized for its business workspace.</p></div><a class="bapx-pill" href="https://docs.bapx.in/ecosystem/">Connector docs</a></div>
<div class="connector-groups">{customerEcosystemGroups.map((group)=><section><h3>{group.title}</h3><div class="connector-grid">{group.entries.map(({item})=><article class="connector-card"><span class="connector-mark" style={`--connector-bg:${item.background}`}>{item.icon?<img src={item.icon} alt=""/>:item.name.slice(0,2)}</span><div><strong>{item.name}</strong><small>In catalog</small></div>{item.name==='OpenAI'?<button class="bapx-pill connect-openai" type="button">Connect with device OAuth</button>:<a class="bapx-pill" href={item.href}>Configure</a>}</article>)}</div></section>)}</div><div id="openai-consent" class="consent" hidden></div></section>
<section class="lower"><article class="panel"><h2>Agents and Admin access</h2><p>Agents uses customer business connections. Admin uses the same operating model for `/root/bapx.in`, plus bapX repository and user management, without inheriting customer secrets.</p><a class="bapx-pill" href="https://agents.bapx.in/threads">Open task oversight</a></article><article class="panel"><h2>Observability and quality</h2><p>Sentry, OpenTelemetry, Braintrust, and Vitest provide errors, traces, and evaluation evidence.</p><a class="bapx-pill" href="https://docs.bapx.in/guide/observability/">Open observability</a></article></section>
</main></div>
<script is:inline>fetch('/api/auth/session').then(r=>r.ok?r.json():Promise.reject()).then(({account})=>{document.querySelector('#account-name').textContent=account.name;document.querySelector('#account-email').textContent=account.email;}).catch(()=>location.href='https://bapx.in/login/');document.querySelector('.connect-openai')?.addEventListener('click',async()=>{const output=document.querySelector('#openai-consent');output.hidden=false;output.textContent='Starting secure OpenAI device sign-in…';const response=await fetch('/api/platform/connectors/openai-codex/device',{method:'POST'});if(!response.ok){output.textContent='OpenAI sign-in is temporarily unavailable.';return}const flow=await response.json();output.innerHTML=`Open <a href="${flow.verificationUri}" target="_blank" rel="noreferrer">${flow.verificationUri}</a> on your device and enter <strong>${flow.userCode}</strong>. bapX never asks for an API key.`});
const keyList=document.querySelector('#key-list');const reveal=document.querySelector('#key-reveal');
function renderKeys(keys){if(!keys.length){keyList.innerHTML='<li class="key-empty">No API keys yet. Create one to call https://api.bapx.in/v1</li>';return}keyList.innerHTML='';for(const key of keys){const row=document.createElement('li');row.className='key-row';const meta=document.createElement('div');const name=document.createElement('strong');name.textContent=key.name;const detail=document.createElement('small');detail.textContent=`${key.prefix}\u2026 \u00b7 created ${new Date(key.createdAt).toLocaleDateString()}${key.lastUsedAt?` \u00b7 last used ${new Date(key.lastUsedAt).toLocaleDateString()}`:' \u00b7 never used'}`;meta.append(name,detail);const revoke=document.createElement('button');revoke.type='button';revoke.className='bapx-pill key-revoke';revoke.textContent='Revoke';revoke.addEventListener('click',async()=>{if(!confirm(`Revoke "${key.name}"? Any application using it stops working immediately.`))return;await fetch(`/api/platform/api-keys/${encodeURIComponent(key.id)}`,{method:'DELETE'});loadKeys()});row.append(meta,revoke);keyList.append(row)}}
async function loadKeys(){try{const response=await fetch('/api/platform/api-keys');if(!response.ok)throw new Error();const {keys}=await response.json();renderKeys(keys)}catch{keyList.innerHTML='<li class="key-empty">API keys are unavailable right now.</li>'}}
document.querySelector('#create-key')?.addEventListener('click',async()=>{const name=prompt('Name this key (for example: production server)','Default key');if(name===null)return;const response=await fetch('/api/platform/api-keys',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name})});if(!response.ok){reveal.hidden=false;reveal.textContent='Could not create the key. Try again.';return}const {secret}=await response.json();reveal.hidden=false;reveal.textContent=`Copy this key now \u2014 it is shown once and never again: ${secret}`;loadKeys()});
loadKeys();</script></body></html>
<style>
body{margin:0;background:#0a0a0a;color:#fff}.platform-shell{display:grid;grid-template-columns:260px 1fr;min-height:100vh}aside{border-right:1px solid #212327;padding:24px 16px;display:flex;flex-direction:column}.brand{margin:0 10px 28px}.brand img{width:112px;height:auto}.switcher{background:#191919;color:#fff;border:1px solid #363a3f;border-radius:8px;padding:12px;text-align:left;display:flex;justify-content:space-between}nav{display:grid;gap:3px;margin-top:20px}nav a{padding:10px 12px;border-radius:8px;color:#dadbdf}nav a.active{background:#1a1c20;color:#fff}.profile{margin-top:auto;display:flex;gap:12px;align-items:center;padding:12px}.profile>span{display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:#fff;color:#0a0a0a}.profile div{display:grid}.profile small,.connector-card small{color:#7d8187}main{padding:44px 5vw}main>header,.panel-head{display:flex;justify-content:space-between;align-items:center;gap:24px}h1{font-size:48px;font-weight:400;letter-spacing:-.04em;margin:8px 0 34px}.metrics{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid #212327;border-radius:8px}.metrics article{padding:24px;border-right:1px solid #212327}.metrics article:last-child{border:0}.metrics span{color:#7d8187}.metrics strong{display:block;font-size:36px;font-weight:400;margin-top:16px}.panel{border:1px solid #212327;border-radius:8px;padding:24px;margin-top:24px;background:#111}.panel h2,.connector-groups h3{font-weight:400;margin:0 0 8px}.panel p{color:#7d8187}.connector-groups{display:grid;gap:24px;margin-top:24px}.connector-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.connector-card{display:flex;align-items:center;gap:12px;border:1px solid #292c31;border-radius:8px;padding:12px}.connector-card>div{display:grid;flex:1}.connector-mark{width:36px;height:36px;display:grid;place-items:center;border-radius:8px;background:var(--connector-bg)}.connector-mark img{max-width:24px;max-height:24px}.site-header{position:sticky;top:0;z-index:50;border-bottom:1px solid #212327;background:rgba(10,10,10,.85);backdrop-filter:blur(6px)}.site-header-inner{display:flex;height:56px;align-items:center;justify-content:space-between;padding:0 24px;gap:24px}.site-header-left{display:flex;align-items:center;gap:28px;min-width:0}.site-brand img{height:26px;width:auto;display:block}.site-links{display:flex;align-items:center;gap:24px}.site-links a{color:#dadbdf;font-size:14px;white-space:nowrap}.site-links a:hover{color:#fff}.site-header-actions{display:flex;align-items:center;gap:10px}.api-keys{margin-top:20px;padding:16px;border:1px solid #363a3f;border-radius:8px;background:#141414}.api-keys-head{display:flex;align-items:center;justify-content:space-between;gap:16px}.api-keys-head .mono-label{margin:0}.api-reveal{margin:14px 0 0;padding:12px;border:1px solid #4d815f;border-radius:8px;background:#0f1a13;word-break:break-all;font-family:ui-monospace,monospace;font-size:13px}.key-list{list-style:none;margin:14px 0 0;padding:0;display:grid;gap:8px}.key-row{display:flex;align-items:center;justify-content:space-between;gap:16px;border:1px solid #292c31;border-radius:8px;padding:12px}.key-row div{display:grid;min-width:0}.key-row small{color:#7d8187}.key-empty{color:#7d8187;font-size:14px}@media(max-width:900px){.site-links{display:none}}.api-facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:16px 0 0}.api-facts div{border:1px solid #292c31;border-radius:8px;padding:12px}.api-facts dt{color:#7d8187;font-size:12px}.api-facts dd{margin:6px 0 0}.api-facts code{background:#0a0a0a;border:1px solid #292c31;border-radius:4px;padding:2px 6px;font-size:13px}.api-facts small{color:#7d8187}.consent{margin-top:20px;padding:16px;border:1px solid #4d815f;border-radius:8px}.consent a{color:#8fcba1}.lower{display:grid;grid-template-columns:1fr 1fr;gap:24px}.lower .panel{min-height:150px}@media(max-width:800px){.platform-shell{grid-template-columns:1fr}aside{display:none}main{padding:24px}.metrics,.connector-grid,.lower,.api-facts{grid-template-columns:1fr}.metrics article{border-bottom:1px solid #212327}}
</style>
