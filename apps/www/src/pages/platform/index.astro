---
import '../../styles/global.css';
import { customerEcosystemGroups } from '../../lib/customer-ecosystem';
const nav=['Account','Billing','Connectors','API keys','MCP','Observability','Settings'];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Platform | bapX</title><link rel="icon" href="/favicon.svg"/></head><body><div class="platform-shell">
<aside><a class="brand brand-lockup" href="https://bapx.in/"><img src="/brand/bapx-logo-main.svg" alt="bapX"/><span>Platform</span></a><button class="switcher">Account settings <span>⌄</span></button><nav>{nav.map((item,i)=><a class={i===0?'active':''} href={`#${item.toLowerCase().replaceAll(' ','-')}`}>{item}</a>)}</nav><div class="profile"><span>BX</span><div><strong id="account-name">Account owner</strong><small id="account-email">Account</small></div></div></aside>
<main><header><div><p class="mono-label">PLATFORM</p><h1>Settings and connectors</h1></div><a class="bapx-pill bapx-pill-primary" href="https://agents.bapx.in/">Open Agents</a></header>
<section class="metrics"><article><span>Plan</span><strong>₹500</strong><small>/month</small></article><article><span>Included storage</span><strong>5 GB</strong></article><article><span>Storage scale</span><strong>₹100</strong><small>/GB/month</small></article><article><span>Limit</span><strong>100 GB</strong></article></section>
<section class="panel"><div class="panel-head"><div><h2>Control plane</h2><p>Manage account settings, billing, connectors, API access, MCPs, and observability. Work happens in Admin or Agents.</p></div><a class="bapx-pill" href="https://docs.bapx.in/platform/overview/">Docs</a></div></section>
<section class="panel" id="connectors"><div class="panel-head"><div><h2>Business connectors</h2><p>Configure connections here. Agents receives only connections authorized for its business workspace.</p></div><a class="bapx-pill" href="https://docs.bapx.in/ecosystem/">Connector docs</a></div>
<div class="connector-groups">{customerEcosystemGroups.map((group)=><section><h3>{group.title}</h3><div class="connector-grid">{group.entries.map(({item})=><article class="connector-card"><span class="connector-mark" style={`--connector-bg:${item.background}`}>{item.icon?<img src={item.icon} alt=""/>:item.name.slice(0,2)}</span><div><strong>{item.name}</strong><small>Available</small></div>{item.name==='OpenAI'?<button class="bapx-pill connect-openai" type="button">Connect with device OAuth</button>:<a class="bapx-pill" href={item.href}>Configure</a>}</article>)}</div></section>)}</div><div id="openai-consent" class="consent" hidden></div></section>
<section class="lower"><article class="panel"><h2>Agents and Admin access</h2><p>Agents uses customer business connections. Admin uses the same operating model for `/root/bapx.in`, plus bapX repository and user management, without inheriting customer secrets.</p><a class="bapx-pill" href="https://agents.bapx.in/threads">Open task oversight</a></article><article class="panel"><h2>Observability and quality</h2><p>Sentry, OpenTelemetry, Braintrust, and Vitest provide errors, traces, and evaluation evidence.</p><a class="bapx-pill" href="https://docs.bapx.in/guide/observability/">Open observability</a></article></section>
</main></div>
<script is:inline>fetch('/api/auth/session').then(r=>r.ok?r.json():Promise.reject()).then(({account})=>{document.querySelector('#account-name').textContent=account.name;document.querySelector('#account-email').textContent=account.email;}).catch(()=>location.href='https://bapx.in/login/');document.querySelector('.connect-openai')?.addEventListener('click',async()=>{const output=document.querySelector('#openai-consent');output.hidden=false;output.textContent='Starting secure OpenAI device sign-in…';const response=await fetch('/api/platform/connectors/openai-codex/device',{method:'POST'});if(!response.ok){output.textContent='OpenAI sign-in is temporarily unavailable.';return}const flow=await response.json();output.innerHTML=`Open <a href="${flow.verificationUri}" target="_blank" rel="noreferrer">${flow.verificationUri}</a> on your device and enter <strong>${flow.userCode}</strong>. bapX never asks for an API key.`})</script></body></html>
<style>
body{margin:0;background:#0a0a0a;color:#fff}.platform-shell{display:grid;grid-template-columns:260px 1fr;min-height:100vh}aside{border-right:1px solid #212327;padding:24px 16px;display:flex;flex-direction:column}.brand{margin:0 10px 28px}.brand img{width:112px;height:auto}.switcher{background:#191919;color:#fff;border:1px solid #363a3f;border-radius:8px;padding:12px;text-align:left;display:flex;justify-content:space-between}nav{display:grid;gap:3px;margin-top:20px}nav a{padding:10px 12px;border-radius:8px;color:#dadbdf}nav a.active{background:#1a1c20;color:#fff}.profile{margin-top:auto;display:flex;gap:12px;align-items:center;padding:12px}.profile>span{display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:#fff;color:#0a0a0a}.profile div{display:grid}.profile small,.connector-card small{color:#7d8187}main{padding:44px 5vw}main>header,.panel-head{display:flex;justify-content:space-between;align-items:center;gap:24px}h1{font-size:48px;font-weight:400;letter-spacing:-.04em;margin:8px 0 34px}.metrics{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid #212327;border-radius:8px}.metrics article{padding:24px;border-right:1px solid #212327}.metrics article:last-child{border:0}.metrics span{color:#7d8187}.metrics strong{display:block;font-size:36px;font-weight:400;margin-top:16px}.panel{border:1px solid #212327;border-radius:8px;padding:24px;margin-top:24px;background:#111}.panel h2,.connector-groups h3{font-weight:400;margin:0 0 8px}.panel p{color:#7d8187}.connector-groups{display:grid;gap:24px;margin-top:24px}.connector-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.connector-card{display:flex;align-items:center;gap:12px;border:1px solid #292c31;border-radius:8px;padding:12px}.connector-card>div{display:grid;flex:1}.connector-mark{width:36px;height:36px;display:grid;place-items:center;border-radius:8px;background:var(--connector-bg)}.connector-mark img{max-width:24px;max-height:24px}.consent{margin-top:20px;padding:16px;border:1px solid #4d815f;border-radius:8px}.consent a{color:#8fcba1}.lower{display:grid;grid-template-columns:1fr 1fr;gap:24px}.lower .panel{min-height:150px}@media(max-width:800px){.platform-shell{grid-template-columns:1fr}aside{display:none}main{padding:24px}.metrics,.connector-grid,.lower{grid-template-columns:1fr}.metrics article{border-bottom:1px solid #212327}}
</style>
