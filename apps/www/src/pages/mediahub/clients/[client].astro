---
import "../../../styles/global.css";
import { mediahubClients, type MediaHubClient } from "../../../lib/mediahub-clients";

export function getStaticPaths() {
  return mediahubClients.map((client) => ({ params: { client: client.slug }, props: client }));
}

const client = Astro.props as MediaHubClient;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{client.name} client work | bapX MediaHub</title>
    <meta name="description" content={client.summary} />
    <link rel="canonical" href={`https://mediahub.bapx.in/clients/${client.slug}/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=bapx-20260711" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="mediahub-page">
    <nav class="sticky top-0 z-50 border-b border-[var(--hairline)] bg-[var(--canvas)]/90 backdrop-blur-sm">
      <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-6">
        <div class="flex h-full items-center gap-8">
          <a href="../../" class="brand-lockup" aria-label="bapX MediaHub home">
            <img src="/brand/bapx-logo-main.svg" alt="bapX" class="h-7 w-auto" /><span>MediaHub</span>
          </a>
          <div class="bapx-nav hidden lg:flex h-full items-center gap-7">
            <a href="../../#services">Services</a><a href="../../#fde">FDE</a><a href="../../#work" class="active">Work</a><a href="../../#process">Process</a>
          </div>
        </div>
        <a href="../../#work" class="bapx-pill">All client work</a>
      </div>
    </nav>

    <main class="client-work-page">
      <section class="client-work-hero">
        <div class="section-inner client-work-hero-grid">
          <div class="client-work-logo">
            <img src={client.logo} alt={client.logoAlt} referrerpolicy="no-referrer" />
          </div>
          <div>
            <span class="mono-label">{client.category}</span>
            <h1>{client.name}</h1>
            <p>{client.summary}</p>
            <div class="client-work-links">
              {client.links.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer" data-kind={link.kind}>{link.label}<span aria-hidden="true">↗</span></a>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="client-case-band">
        <div class="section-inner">
          <div class="client-case-intro">
            <h2>{client.narrative}</h2>
            <div><span>Customer context</span><p>{client.challenge}</p></div>
          </div>
          <div class="client-delivery-grid">
            <div>
              <span>Delivered and maintained</span>
              <ul>
                {client.shipped.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div>
              <span>How we maintain it</span>
              <p>{client.operating}</p>
            </div>
          </div>
        </div>
      </section>

      {client.social ? (
        <section class="client-case-band client-social-section">
          <div class="section-inner">
            <div class="client-social-heading">
              <h2>Social work connected to the customer journey.</h2>
              <p>{client.social.narrative}</p>
            </div>
            <div class="social-example-list">
              {client.social.examples.map((example) => (
                <a href={example.href} target="_blank" rel="noopener noreferrer">
                  <span>{example.label}</span><strong>{example.title}</strong><em aria-hidden="true">↗</em>
                </a>
              ))}
            </div>
          </div>
        </section>
      ) : null}

      <section class="client-evidence-band">
        <div class="section-inner client-evidence-row">
          <div><span class="mono-label">Evidence boundary</span><p>This narrative is limited to the live customer surface, supplied public source repositories, linked customer channels, and the maintenance scope confirmed by bapX MediaHub.</p></div>
          <a href={client.logoSource} target="_blank" rel="noopener noreferrer">Brand asset source <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>

    <footer class="page-footer"><div class="section-inner"><span>bapX MediaHub · Active client portfolio</span><span>&copy; {new Date().getFullYear()}</span></div></footer>
  </body>
</html>
